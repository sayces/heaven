{
  "compilerOptions": {
    
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "esnext",
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,
    "noImplicitAny": false,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,

    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
